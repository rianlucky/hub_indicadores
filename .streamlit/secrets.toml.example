# Copie para secrets.toml (local) ou cole nos Secrets do Streamlit Cloud.
# secrets.toml está no .gitignore — nunca commitar com a senha real.
# Usuário do Hub: só leitura em ops.v_ultima_carga (migração 008).
# Sem este bloco o Hub funciona, só mostra o texto de "atualizacao" no lugar da data.
[neon_hub]
database_url = "postgresql://USUARIO_HUB:SENHA@HOST/neondb?sslmode=require"

# E-mail do rodapé ("Dúvidas ou pedido de acesso"); sem ele o rodapé sai sem o contato.
[app]
email_suporte = "seu.email@empresa.com"
