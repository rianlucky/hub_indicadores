# Copie para secrets.toml (local) ou cole nos Secrets do Streamlit Cloud.
# secrets.toml está no .gitignore — nunca commitar com a senha real.
# Usuário app_hub: só leitura em ops.v_ultima_carga (migração 008).
# Sem este bloco o Hub funciona, só mostra o texto de "atualizacao" no lugar da data.
[neon_hub]
database_url = "postgresql://app_hub:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
